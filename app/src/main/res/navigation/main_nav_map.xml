<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_map"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.bpr.front2.home.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_userFragment"
            app:destination="@id/userFragment" />
        <action
            android:id="@+id/action_homeFragment_to_teacherFragment"
            app:destination="@id/teacherFragment" />
        <action
            android:id="@+id/action_homeFragment_to_resListFragment"
            app:destination="@id/resListFragment" />
    </fragment>
    <fragment
        android:id="@+id/userFragment"
        android:name="com.bpr.front2.home.user.UserFragment"
        android:label="@string/user_title"
        tools:layout="@layout/fragment_user" >
        <action
            android:id="@+id/action_userFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_userFragment_to_accountFragment"
            app:destination="@id/accountFragment" />
        <action
            android:id="@+id/action_userFragment_to_aboutFragment"
            app:destination="@id/aboutFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.bpr.front2.home.user.AccountFragment"
        android:label="@string/user_item1"
        tools:layout="@layout/fragment_account" >
        <action
            android:id="@+id/action_accountFragment_to_userFragment"
            app:destination="@id/userFragment" />
    </fragment>
    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.bpr.front2.home.user.AboutFragment"
        android:label="@string/user_item2"
        tools:layout="@layout/fragment_about" >
        <action
            android:id="@+id/action_aboutFragment_to_userFragment"
            app:destination="@id/userFragment" />
    </fragment>
    <fragment
        android:id="@+id/teacherFragment"
        android:name="com.bpr.front2.home.user.teacher.TeacherFragment"
        android:label="@string/user_item_teacher1"
        tools:layout="@layout/fragment_teacher" >
        <action
            android:id="@+id/action_teacherFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_teacherFragment_to_uploadResFragment"
            app:destination="@id/uploadResFragment" />
    </fragment>
    <fragment
        android:id="@+id/uploadResFragment"
        android:name="com.bpr.front2.home.user.teacher.uploadPage.UploadResFragment"
        android:label="fragment_upload_res"
        tools:layout="@layout/fragment_upload_res" >
        <action
            android:id="@+id/action_uploadResFragment_to_teacherFragment"
            app:destination="@id/teacherFragment" />
    </fragment>
    <fragment
        android:id="@+id/resListFragment"
        android:name="com.bpr.front2.home.user.course.ResListFragment"
        android:label="fragment_res_list"
        tools:layout="@layout/fragment_res_list" >
        <action
            android:id="@+id/action_resListFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>